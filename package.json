{
  "name": "dsh-element-ref",
  "version": "0.9.0",
  "description": "元素引用：在浏览器里点选页面元素，写一句要改什么，发送后模型按这处上下文改代码。",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "smoke": "node scripts/smoke-server.mjs && node scripts/smoke-client.mjs && node scripts/smoke-picker.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./picker.js": "./lib/picker.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "element-picker",
    "reference"
  ],
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "author": "kanxue0201",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanxue0201/dsh-element-ref.git"
  },
  "homepage": "https://github.com/kanxue0201/dsh-element-ref#readme",
  "bugs": {
    "url": "https://github.com/kanxue0201/dsh-element-ref/issues"
  },
  "license": "MIT"
}
